generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model events {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id   String       @db.Uuid
  title      String
  store_name String?
  closed_at  DateTime?    @db.Timestamptz(6)
  created_at DateTime?    @default(now()) @db.Timestamptz(6)
  members    members[]
  menu_items menu_items[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model members {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id       String  @db.Uuid
  display_name   String
  pin_hash       String?
  pin_fail_count Int     @default(0)
  events         events  @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders         orders?

  @@unique([event_id, display_name], map: "members_event_name_uq")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model menu_items {
  id                                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id                               String   @db.Uuid
  name                                   String
  events                                 events   @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders_orders_alt_choiceTomenu_items   orders[] @relation("orders_alt_choiceTomenu_items")
  orders_orders_first_choiceTomenu_items orders[] @relation("orders_first_choiceTomenu_items")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model orders {
  member_id                                  String      @id @db.Uuid
  first_choice                               String      @db.Uuid
  alt_choice                                 String?     @db.Uuid
  memo                                       String?
  menu_items_orders_alt_choiceTomenu_items   menu_items? @relation("orders_alt_choiceTomenu_items", fields: [alt_choice], references: [id], onDelete: NoAction, onUpdate: NoAction)
  menu_items_orders_first_choiceTomenu_items menu_items  @relation("orders_first_choiceTomenu_items", fields: [first_choice], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members                                    members     @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  google_sub String   @unique
  email      String
  name       String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
}
